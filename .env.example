# Copy to .env. Keep real credentials and private contest links out of Git.
POLYGON_API_KEY=your_api_key
POLYGON_API_SECRET=your_api_secret
POLYGON_CONTEST_URL=https://polygon.codeforces.com/contest?contestId=12345
# Optional API PIN; ccid in a shared contest URL is NOT this PIN.
# POLYGON_PIN=

# PDF cover and problem-page header (plain text, not TeX commands).
# Independent of Polygon/DOMjudge contest IDs. Empty date hides it.
CONTEST_SLUG=2026-fall
CONTEST_TITLE="KGUPC 2026 Fall"
CONTEST_DATE=2026-10-29
CONTEST_AUTHOR="Solutio in Kyonggi Univ."

# DOMjudge server root URL (or its /api/v4 URL).
# Example: https://judge.example.com/domjudge
DOMJUDGE_URL=https://judge.example.com
# Problem ZIP import requires an account with the admin role.
# For automatic jury-solution submissions, associate this user with a jury test team
# in the target contest. See README step 2; no additional API key is needed.
DOMJUDGE_USERNAME=your_admin_username
DOMJUDGE_PASSWORD=your_admin_password
# Get the API contest ID with: kgupc-pol2dom domjudge-list
# Full deploy synchronizes this contest: problems absent from Polygon are removed from it.
DOMJUDGE_CONTEST_ID=your_test_contest_id
